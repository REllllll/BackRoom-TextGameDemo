# Unified game Dockerfile
# Includes SWI-Prolog and PDDL4J

# Stage 1: build PDDL4J
FROM gradle:8-jdk17 AS pddl4j-builder

# Accept proxy settings as build args (optional)
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

# Install required tools
RUN apt-get update && apt-get install -y \
    git \
    && rm -rf /var/lib/apt/lists/*

# Clone the PDDL4J repo (try using a proxy; fall back to direct clone)
WORKDIR /tmp
RUN if [ -n "$HTTP_PROXY" ] && [ -n "$HTTPS_PROXY" ]; then \
        echo "Trying to clone via proxy..." && \
        export HTTP_PROXY="$HTTP_PROXY" && \
        export HTTPS_PROXY="$HTTPS_PROXY" && \
        git config --global http.proxy "$HTTP_PROXY" && \
        git config --global https.proxy "$HTTPS_PROXY" && \
        (git clone https://github.com/pellierd/pddl4j.git || \
         (echo "Proxy clone failed; trying direct clone..." && \
          git config --global --unset http.proxy && \
          git config --global --unset https.proxy && \
          unset HTTP_PROXY HTTPS_PROXY && \
          git clone https://github.com/pellierd/pddl4j.git)); \
    else \
        echo "Cloning directly (no proxy configured)..." && \
        git clone https://github.com/pellierd/pddl4j.git; \
    fi

# Build PDDL4J
WORKDIR /tmp/pddl4j
# Use system gradle (from base image) instead of the wrapper to avoid version conflicts
RUN gradle jar --no-daemon

# Stage 2: final image (SWI-Prolog + PDDL4J)
FROM swipl:latest

# Install Java and dev tools
RUN apt-get update && apt-get install -y \
    openjdk-17-jdk \
    curl \
    vim \
    nano \
    git \
    less \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Set Java environment variables
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH=$PATH:$JAVA_HOME/bin

# Copy the PDDL4J jar from the build stage
COPY --from=pddl4j-builder /tmp/pddl4j/build/libs/pddl4j-*.jar /opt/pddl4j/pddl4j.jar

# Create an FF planner wrapper script (Fast Forward)
# Supports Fast-Forward style: ff -o DOMAIN -f PROBLEM
# Also supports PDDL4J style: ff DOMAIN PROBLEM
RUN echo '#!/bin/bash\n\
# Parse args\n\
DOMAIN=""\n\
PROBLEM=""\n\
OUTPUT=""\n\
\n\
while [[ $# -gt 0 ]]; do\n\
  case $1 in\n\
    -o)\n\
      DOMAIN="$2"\n\
      shift 2\n\
      ;;\n\
    -f)\n\
      PROBLEM="$2"\n\
      shift 2\n\
      ;;\n\
    -*)\n\
      shift\n\
      ;;\n\
    *)\n\
      if [ -z "$DOMAIN" ]; then\n\
        DOMAIN="$1"\n\
      elif [ -z "$PROBLEM" ]; then\n\
        PROBLEM="$1"\n\
      fi\n\
      shift\n\
      ;;\n\
  esac\n\
done\n\
\n\
# Validate args\n\
if [ -z "$DOMAIN" ] || [ -z "$PROBLEM" ]; then\n\
  echo "Usage: ff -o DOMAIN -f PROBLEM" >&2\n\
  echo "   or: ff DOMAIN PROBLEM" >&2\n\
  exit 1\n\
fi\n\
\n\
# Run the PDDL4J FF planner\n\
java -cp /opt/pddl4j/pddl4j.jar fr.uga.pddl4j.planners.statespace.FF "$DOMAIN" "$PROBLEM"\n\
exit $?\n\
' > /usr/local/bin/ff && chmod +x /usr/local/bin/ff

# Create a generic PDDL4J runner script
RUN echo '#!/bin/bash\n\
java -cp /opt/pddl4j/pddl4j.jar "$@"\n\
' > /usr/local/bin/pddl4j && chmod +x /usr/local/bin/pddl4j

WORKDIR /workspace

