# Nginx config example - development (disable caching)
# Add this to your nginx configuration

server {
    listen 80;
    server_name your-domain.com;  # Replace with your domain or IP
    
    # Frontend static files directory
    root /path/to/BackRoom-TextGameDemo/playground;  # Replace with the real path
    index index.html;

    # Disable caching for static assets (development)
    location ~* \.(js|css|html)$ {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
        try_files $uri =404;
    }

    # API proxy to backend server
    location /api {
        proxy_pass http://localhost:8080;  # Replace with the real backend address
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Other static files
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# ============================================================================
# Production configuration (enable caching, use versioning)
# ============================================================================
# In production, consider:
# 1. Use versioning (e.g., app.js?v=1.0.0)
# 2. Configure long-term caching (e.g., 1 year)
# 3. Use file hashes for versioning (e.g., app.abc123.js)
#
# Example:
# location ~* \.(js|css)$ {
#     expires 1y;
#     add_header Cache-Control "public, immutable";
# }
#
# Then reference the versioned asset in HTML:
# <script src="app.js?v=1.0.0"></script>

